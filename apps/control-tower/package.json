{
  "name": "control-tower",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "grant:platform-role": "tsx scripts/grant-platform-role.ts",
    "verify:auth-config": "tsx scripts/verify-auth-config.ts",
    "verify:platform-authorization": "tsx scripts/verify-platform-authorization.ts",
    "cutover:control-tower": "tsx scripts/cutover-control-tower.ts",
    "test:unit": "vitest run --coverage"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.10.0",
    "@workspace/contracts": "*",
    "@workspace/core": "*",
    "@workspace/db-control-tower": "*",
    "@workspace/next-config": "*",
    "@workspace/observability": "*",
    "@workspace/service-auth": "*",
    "@workspace/ui": "*",
    "better-auth": "^1.7.13",
    "dotenv": "^18.0.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^5.1.0"
  }
}
