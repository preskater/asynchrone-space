    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "eslint": "^10",
    "tsx": "^4.23.15",
    "typescript": "^7"
