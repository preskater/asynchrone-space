# Same database as apps/web. The control tower shares the schema through
# @workspace/db and never defines its own Prisma schema.
DATABASE_URL="postgresql://preskater:preskater@localhost:5432/preskater?schema=public"
DATABASE_POOL_MAX="3"

# Public origin of this app (not the customer app).
BETTER_AUTH_URL="http://localhost:3001"

# Deliberately different from the web app's BETTER_AUTH_SECRET. The control
# tower does not register the jwt/mcp plugins, so it never needs to decrypt the
# shared JWKS rows. Use at least 32 characters.
CONTROL_TOWER_BETTER_AUTH_SECRET=""

# Origin of the customer app. Used for impersonation handoff links and
# "open in app" links. This app never reads or sets cookies on that origin.
PLATFORM_APP_URL="http://localhost:3000"
