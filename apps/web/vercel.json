{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run generate --workspace=@workspace/db && npm run build",
  "crons": [
    {
      "path": "/api/files/uploads/sweep",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/repository-sync",
      "schedule": "0 * * * *"
    }
  ]
}
