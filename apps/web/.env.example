DATABASE_URL="postgresql://preskater:preskater@localhost:5432/preskater?schema=public"
# Maximum Postgres connections per serverless instance (keep small on Vercel;
# point DATABASE_URL at a pooler such as Neon/PgBouncer/Supabase in production).
DATABASE_POOL_MAX="3"
# Signs sessions and encrypts the MCP/OAuth JWKS keys stored in the database.
# Keep it identical wherever the app runs (docker compose loads this file into
# the web container). When rotating it, delete the rows in the `jwks` table so
# the keys are regenerated.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# File uploads are stored as PostgreSQL large objects in the same database as
# the metadata (no external object storage). Each upload/download streams over
# a pooled connection; see README for operational caveats.

# OpenAI (assistant + tools). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional custom OpenAI-compatible base URL (e.g. an OpenAI-compatible gateway).
OPENAI_API_URL=""
ASSISTANT_MODEL="gpt-4o-mini"

# Public identifier of the OAuth2-protected MCP endpoint. Access tokens are
# audience-bound to this value and it is published as the RFC 9728 protected
# resource metadata. Defaults to "${BETTER_AUTH_URL}/mcp".
MCP_RESOURCE_URL=""

# Guards GET /api/files/uploads/sweep. Vercel Cron sends this as a Bearer
# token when the variable is set. Leave empty locally; unfinished uploads are
# also swept opportunistically when a new upload session starts.
CRON_SECRET=""

# Optional GitHub/GitLab OAuth apps. When configured, users can link their
# account (Account settings → Connected accounts) as an alternative to the
# personal access token they save in their profile (Account settings →
# Repository access); tokens are what author their issues and pull requests.
# Redirect URLs: {BETTER_AUTH_URL}/api/auth/callback/github and
# {BETTER_AUTH_URL}/api/auth/callback/gitlab.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Transactional email (email verification + password reset) via Resend.
# Leave RESEND_API_KEY empty to skip sending (a startup warning is logged).
RESEND_API_KEY=""
# Must be an address on a domain verified in the Resend dashboard,
# e.g. "Presk <noreply@yourdomain.com>".
EMAIL_FROM=""
# Inbox that receives the in-app feedback reports (comma-separated for several
# recipients). Falls back to EMAIL_FROM when empty.
FEEDBACK_EMAIL_TO=""
# Public origin used for links inside emails. Defaults to BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=""

# Origin of the control-tower app. Used by the impersonation banner to send an
# operator back after "Stop impersonating". The two apps never share cookies.
CONTROL_TOWER_URL=""
# Block email/password sign-in until the address is verified. Requires
# RESEND_API_KEY and EMAIL_FROM; the app refuses to boot otherwise.
# Off by default: existing accounts have no `emailVerified` date yet, so
# turning it on locks them out until they verify. Backfill those rows first.
REQUIRE_EMAIL_VERIFICATION="false"
