DATABASE_URL="postgresql://preskater:preskater@localhost:5432/preskater?schema=public"
# Maximum Postgres connections per serverless instance (keep small on Vercel;
# point DATABASE_URL at a pooler such as Neon/PgBouncer/Supabase in production).
DATABASE_POOL_MAX="3"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# File uploads are stored as PostgreSQL large objects in the same database as
# the metadata (no external object storage). Each upload/download streams over
# a pooled connection; see README for operational caveats.

# OpenAI (assistant + tools). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional custom OpenAI-compatible base URL (e.g. an OpenAI-compatible gateway).
OPENAI_API_URL=""
ASSISTANT_MODEL="gpt-4o-mini"

# Public identifier of the OAuth2-protected MCP endpoint. Access tokens are
# audience-bound to this value and it is published as the RFC 9728 protected
# resource metadata. Defaults to "${BETTER_AUTH_URL}/mcp".
MCP_RESOURCE_URL=""
