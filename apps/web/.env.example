DATABASE_URL="postgresql://asynchrone:asynchrone@localhost:5432/asynchrone?schema=public"
# Maximum Postgres connections per app instance. In production this is
# replicas x DATABASE_POOL_MAX, so point DATABASE_URL at a pooler
# (PgBouncer/Neon/Supabase) or keep the product below the database limit.
DATABASE_POOL_MAX="3"
# Signs sessions and encrypts the MCP/OAuth JWKS keys stored in the database.
# Keep it identical wherever the app runs (docker compose loads this file into
# the web container). When rotating it, delete the rows in the `jwks` table so
# the keys are regenerated.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# App origins used by the OAuth resource registry and cross-app links. Each
# deployment sets the real hosts; the local fallbacks live in
# @workspace/contracts. The landing and control tower are not OAuth resources.
LANDING_APP_URL="http://localhost:3002"
COPILOT_APP_URL="http://localhost:3003"
PROJECTS_APP_URL="http://localhost:3004"
CALENDARS_APP_URL="http://localhost:3005"
FILES_APP_URL="http://localhost:3006"
MESSAGES_APP_URL="http://localhost:3007"
CLIENTS_APP_URL="http://localhost:3008"
EMPLOYEES_APP_URL="http://localhost:3009"
CONTROL_TOWER_APP_URL="http://localhost:3001"

# File uploads are stored as PostgreSQL large objects in the same database as
# the metadata (no external object storage). Each upload/download streams over
# a pooled connection; see README for operational caveats.

# OpenAI (assistant + tools). Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""
# Optional custom OpenAI-compatible base URL (e.g. an OpenAI-compatible gateway).
OPENAI_API_URL=""
ASSISTANT_MODEL="gpt-4o-mini"

# Public identifier of the OAuth2-protected MCP endpoint. Access tokens are
# audience-bound to this value and it is published as the RFC 9728 protected
# resource metadata. Defaults to "${BETTER_AUTH_URL}/mcp".
MCP_RESOURCE_URL=""

# Comma-separated client IDs that may skip the OAuth client lookup cache.
# First-party app clients are provisioned with their own resource in #182.
OAUTH_TRUSTED_CLIENT_IDS=""

# Guards GET /api/files/uploads/sweep and GET /api/cron/repository-sync.
# The Helm CronJobs send this as a Bearer token. Leave empty locally; the
# sweep also runs opportunistically when a new upload session starts.
CRON_SECRET=""

# Optional GitHub/GitLab OAuth apps. When configured, users can link their
# account (Account settings → Connected accounts) as an alternative to the
# personal access token they save in their profile (Account settings →
# Repository access); tokens are what author their issues and pull requests.
# Redirect URLs: {BETTER_AUTH_URL}/api/auth/callback/github and
# {BETTER_AUTH_URL}/api/auth/callback/gitlab.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITLAB_CLIENT_ID=""
GITLAB_CLIENT_SECRET=""

# Transactional email (email verification + password reset) via Resend.
# Leave RESEND_API_KEY empty to skip sending (a startup warning is logged).
RESEND_API_KEY=""
# Must be an address on a domain verified in the Resend dashboard,
# e.g. "Asynchrone Space <noreply@yourdomain.com>".
EMAIL_FROM=""
# Inbox that receives the in-app feedback reports (comma-separated for several
# recipients). Falls back to EMAIL_FROM when empty.
FEEDBACK_EMAIL_TO=""
# Public origin used for links inside emails. Defaults to BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=""

# Origin of the control-tower app. Used by the impersonation banner to send an
# operator back after "Stop impersonating". The two apps never share cookies.
CONTROL_TOWER_URL=""
# Block email/password sign-in until the address is verified. Requires
# RESEND_API_KEY and EMAIL_FROM; the app refuses to boot otherwise, so set it
# to "false" for local development without an email provider. The migration
# `20261031100000_backfill_email_verified` marks existing accounts verified.
REQUIRE_EMAIL_VERIFICATION="true"

# Billing (Stripe). Leave STRIPE_SECRET_KEY empty to run without billing: the
# Settings → Billing page still lists the plan but hides checkout and the
# customer portal. Use test-mode keys (sk_test_…) locally.
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint that points at
# {BETTER_AUTH_URL}/api/webhooks/stripe. Run `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe` to get one for local development.
STRIPE_WEBHOOK_SECRET=""
# Reserved for Stripe Elements/embedded checkout. Hosted Checkout does not need
# it, so it can stay empty.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Optional Stripe Price IDs. When empty, the Team price is sent inline to
# Checkout (€12/month, €120/year) so a test workspace works without products.
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
# Enables Stripe Tax on Checkout (VAT). Requires a tax registration in the
# Stripe dashboard; leave empty to let Stripe show the tax it can compute from
# the billing address.
STRIPE_AUTOMATIC_TAX=""

# Sign-up abuse controls (issue #90). Auth endpoints are also rate limited per
# client IP in production, shared across replicas through the database.
# Cloudflare Turnstile on sign-up and password reset; set both or neither.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Only addresses with a pending invitation may create an account.
SIGNUP_INVITE_ONLY="false"
# Comma-separated domains to refuse at sign-up, on top of the built-in
# disposable-email list (subdomains are blocked too).
SIGNUP_BLOCKED_EMAIL_DOMAINS=""

# Which request headers carry the client IP for the per-IP auth rate limits
# (comma-separated, checked in order). Only trustworthy behind a proxy that
# overwrites them — ingress-nginx sets X-Real-IP — so never expose the app
# directly in production.
TRUSTED_IP_HEADERS="x-real-ip,x-forwarded-for"

# Sentry error tracking and request timings (optional). Leave empty to disable.
# The DSN is public: it is also inlined into the browser bundle at build time,
# so the Docker build needs it as the SENTRY_DSN build arg.
SENTRY_DSN=""
