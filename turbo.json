{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "generate": {
      "cache": true,
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["lib/generated/**"],
      "env": ["DATABASE_URL"]
    },
    "build": {
      "dependsOn": ["^build", "^generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "OPENAI_API_KEY",
        "OPENAI_API_URL",
        "ASSISTANT_MODEL",
        "MCP_RESOURCE_URL",
        "CRON_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITLAB_CLIENT_ID",
        "GITLAB_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "FEEDBACK_EMAIL_TO",
        "NEXT_PUBLIC_APP_URL",
        "REQUIRE_EMAIL_VERIFICATION",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "SIGNUP_INVITE_ONLY",
        "SIGNUP_BLOCKED_EMAIL_DOMAINS",
        "TRUSTED_IP_HEADERS",
        "CONTROL_TOWER_BETTER_AUTH_SECRET",
        "PLATFORM_APP_URL",
        "CONTROL_TOWER_URL",
        "PLATFORM_ALLOWED_IPS",
        "DEPLOY_ENV",
        "GIT_COMMIT_SHA",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PRICE_TEAM_MONTHLY",
        "STRIPE_PRICE_TEAM_YEARLY",
        "STRIPE_AUTOMATIC_TAX"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "^generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "DATABASE_POOL_MAX",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "OPENAI_API_KEY",
        "OPENAI_API_URL",
        "ASSISTANT_MODEL",
        "MCP_RESOURCE_URL",
        "CRON_SECRET",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "GITLAB_CLIENT_ID",
        "GITLAB_CLIENT_SECRET",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "FEEDBACK_EMAIL_TO",
        "NEXT_PUBLIC_APP_URL",
        "REQUIRE_EMAIL_VERIFICATION",
        "TURNSTILE_SITE_KEY",
        "TURNSTILE_SECRET_KEY",
        "SIGNUP_INVITE_ONLY",
        "SIGNUP_BLOCKED_EMAIL_DOMAINS",
        "TRUSTED_IP_HEADERS",
        "CONTROL_TOWER_BETTER_AUTH_SECRET",
        "PLATFORM_APP_URL",
        "CONTROL_TOWER_URL",
        "PLATFORM_ALLOWED_IPS",
        "DEPLOY_ENV",
        "GIT_COMMIT_SHA",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "STRIPE_PRICE_TEAM_MONTHLY",
        "STRIPE_PRICE_TEAM_YEARLY",
        "STRIPE_AUTOMATIC_TAX"
      ]
    }
  }
}
