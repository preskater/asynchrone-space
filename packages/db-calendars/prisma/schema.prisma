datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

model Calendar {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  color          String       @default("blue")
  kind           String       @default("personal")
  visible        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  members CalendarMember[]
  events  CalendarEvent[]

  @@index([organizationId])
  @@map("calendar")
}

model CalendarMember {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([calendarId, userId])
  @@index([userId])
  @@map("calendarMember")
}

model CalendarEvent {
  id              String       @id @default(cuid())
  organizationId  String
  calendarId      String
  calendar        Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean      @default(false)
  location        String?
  meetingUrl      String?
  /// Optional password/access code shared with online meeting attendees.
  meetingPassword String?
  color           String       @default("blue")
  reminderMinutes Int?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attendees      EventAttendee[]
  meetingRequest MeetingRequest?

  @@index([organizationId])
  @@index([calendarId])
  @@index([startAt])
  @@map("calendarEvent")
}

model EventAttendee {
  id       String        @id @default(cuid())
  eventId  String
  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  response String        @default("pending")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("eventAttendee")
}

model MeetingSettings {
  id     String @id @default(cuid())
  /// One settings row per organization.
  organizationId String       @unique

  /// Whether client-portal users may request meetings at all.
  clientRequestsEnabled Boolean @default(true)
  /// Refuse a request that overlaps another meeting instead of flagging it.
  autoDeclineOverlaps Boolean @default(true)
  /// How far ahead (days from today) a meeting may be requested.
  bookingWindowDays Int @default(30)
  /// Minimum notice before the requested slot (hours).
  minNoticeHours Int @default(24)
  /// Duration pre-selected in the portal form (minutes).
  defaultDurationMinutes Int @default(30)
  /// Longest meeting a client may request (minutes).
  maxDurationMinutes Int @default(120)
  /// Meeting app used when a request is accepted: manual | google_meet |
  /// microsoft_teams | zoom. Credentials for an app are added with its
  /// provider adapter in `lib/meetings/providers.ts`.
  provider String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetingSettings")
}

model MeetingRequest {
  id              String       @id @default(cuid())
  organizationId  String
  clientId        String
  title           String
  description     String?
  /// Candidate slots proposed by the client, in display order.
  slots           MeetingSlot[]
  /// online | in_person
  mode            String  @default("online")
  /// Online meetings: join link provided by the client.
  meetingUrl      String?
  /// Online meetings: optional access code/password.
  meetingPassword String?
  /// In-person meetings: address provided by the client.
  address         String?
  /// pending | accepted | declined | cancelled
  status          String  @default("pending")

  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  /// Reason given on decline, or a message shown to the client on accept.
  decisionNote    String?

  /// Calendar event created when the request is accepted.
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  /// Meeting app adapter that produced the join link (manual until connected).
  provider          String  @default("manual")
  externalMeetingId String?
  externalJoinUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([clientId])
  @@map("meetingRequest")
}

model MeetingSlot {
  id        String         @id @default(cuid())
  requestId String
  request   MeetingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  /// Display order of the proposal (0-based).
  position  Int            @default(0)
  /// Set on the slot the team picked when accepting.
  selected  Boolean        @default(false)

  @@unique([requestId, startAt])
  @@index([requestId])
  @@index([startAt])
  @@map("meetingSlot")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  /// Acting user id, or `"system"` for jobs and provider webhooks.
  actorId        String
  /// Actor name and email at write time (`null` only for rows written before
  /// these columns existed, and for system actors).
  actorName      String?
  actorEmail     String?
  action         String
  entityType     String
  entityId       String
  /// Human label of the target at write time (task key, member email, file name).
  entityLabel    String?
  ipAddress      String?
  userAgent      String?
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, createdAt])
  @@map("auditLog")
}