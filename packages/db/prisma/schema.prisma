datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  banned        Boolean?     @default(false)
  banReason     String?
  banExpires    DateTime?
  twoFactorEnabled Boolean?  @default(false)
  lastSeenAt    DateTime?
  sessions      Session[]
  accounts      Account[]
  teammembers   TeamMember[]
  members       Member[]
  invitations   Invitation[]
  twoFactor     TwoFactor[]

  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]
  repositoryTokens   UserRepositoryToken[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?
  activeTeamId         String?
  impersonatedBy       String?

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id                String       @id
  name              String
  slug              String
  logo              String?
  createdAt         DateTime
  metadata          String?
  storageQuotaBytes BigInt?
  /// Team trial window. The trial grants Team while `trialEndsAt` is in the
  /// future; `metadata.plan` is never changed by it.
  trialStartedAt      DateTime?
  trialEndsAt         DateTime?
  /// Set once by the trial-expiry cron so reminders and expiry never repeat.
  trialReminderSentAt DateTime?
  trialEndedAt        DateTime?
  /// Owner-requested deletion. The organization-deletion cron removes the
  /// organization once this date has passed; clearing it cancels the request.
  deletionScheduledAt   DateTime?
  deletionRequestedById String?
  teams             Team[]
  members           Member[]
  invitations       Invitation[]

  projects       Project[]
  labels         Label[]
  tasks          Task[]
  taskTemplates  TaskTemplate[]
  taskIdentifierCounters TaskIdentifierCounter[]
  calendars      Calendar[]
  calendarEvents CalendarEvent[]
  files          FileNode[]
  chatTeams      ChatTeam[]
  conversations  Conversation[]

  hrProfiles         HrProfile[]
  attendanceEntries  AttendanceEntry[]
  leaveRequests      LeaveRequest[]
  leaveBalances      LeaveBalance[]
  leaveAdjustments   LeaveAdjustment[]
  clients            Client[]
  internalActivities InternalActivity[]
  auditLogs          AuditLog[]
  hrSettings         HrSettings?
  salaryProfiles     SalaryProfile[]

  contacts            Contact[]
  pipelines           Pipeline[]
  deals               Deal[]
  crmActivities       CrmActivity[]
  crmFieldDefinitions CrmFieldDefinition[]
  crmDocuments        CrmDocument[]
  notifications       Notification[]
  portalInvites       PortalInvite[]
  projectMessages     ProjectMessage[]

  repositoryConnections RepositoryConnection[]

  meetingSettings MeetingSettings?
  meetingRequests MeetingRequest[]

  aiUsageEvents AiUsageEvent[]

  @@unique([slug])
  @@map("organization")
}

/// One row per Team trial ever started. Deliberately not related to
/// Organization so deleting a workspace does not free its email/domain for a
/// new trial.
model TrialClaim {
  id             String   @id @default(cuid())
  email          String   @unique
  /// Null for public mailbox providers (gmail.com…), which are not blocked.
  domain         String?
  organizationId String
  createdAt      DateTime @default(now())

  @@unique([domain])
  @@map("trialClaim")
}

model Team {
  id             String       @id
  name           String
  memberCount    Int          @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime
  updatedAt      DateTime?    @updatedAt
  teammembers    TeamMember[]

  @@index([organizationId])
  @@map("team")
}

model TeamMember {
  id            String    @id
  teamId        String
  team          Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipKey String?
  createdAt     DateTime?

  @@unique([membershipKey])
  @@index([teamId])
  @@index([userId])
  @@map("teamMember")
}

model Member {
  id               String       @id
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             String       @default("member")
  /// Set for client-portal members: the company whose projects they can see.
  clientId         String?
  client           Client?      @relation("PortalMembers", fields: [clientId], references: [id], onDelete: SetNull)
  /// Last time the portal user opened their dashboard or a project (unread badges).
  portalLastSeenAt DateTime?
  createdAt        DateTime

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([clientId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  teamId         String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// ---------------------------------------------------------------------------
// Projects & tasks
// ---------------------------------------------------------------------------

model Project {
  id                 String       @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             String       @default("active")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  dueDate            DateTime?
  clientId           String?
  client             Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Client-portal visibility and contribution policies (`none | read | read_write`).
  clientVisible      Boolean      @default(true)
  clientDiscussion   String       @default("read_write")
  clientTaskComments String       @default("read_write")
  plannedHours       Float?
  isBillable         Boolean      @default(true)
  startDate          DateTime?
  endDate            DateTime?

  members           ProjectMember[]
  labels            ProjectLabel[]
  tasks             Task[]
  activities        ProjectActivity[]
  templates         TaskTemplate[]
  attendanceEntries AttendanceEntry[]
  messages          ProjectMessage[]
  repository        RepositoryConnection?

  @@index([organizationId])
  @@index([clientId])
  @@map("project")
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
  @@map("projectMember")
}

model Label {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String
  createdAt      DateTime     @default(now())

  projects ProjectLabel[]
  tasks    TaskLabel[]

  @@unique([organizationId, name])
  @@map("label")
}

model ProjectLabel {
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labelId   String
  label     Label   @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([projectId, labelId])
  @@map("projectLabel")
}

model Task {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  identifier     String
  title          String
  description    String?
  status         String        @default("todo")
  priority       String        @default("medium")
  assigneeId     String?
  dueDate        DateTime?
  endDate        DateTime?
  templateId     String?
  template       TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Values for the custom fields of `template`, keyed by field id.
  customFields   Json          @default("{}")
  order          Int           @default(0)
  /// Whether this task is reported to the project's connected repository as
  /// an issue. Chosen on the task form when the project has a repository;
  /// `false` tasks stay local (no issue, no pull request, no backfill).
  createIssue    Boolean       @default(true)
  /// Repository issue this task is synced with, if the project has a
  /// repository connection. Set on backfill, task creation and remote events.
  externalIssueNumber Int?
  externalIssueUrl    String?
  externalPrNumber    Int?
  externalPrUrl       String?
  /// `updatedAt` of the remote issue when it was last applied locally, used
  /// to detect stale webhook payloads and avoid feedback loops.
  externalUpdatedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  subtasks Subtask[]
  comments TaskComment[]
  labels   TaskLabel[]

  @@unique([organizationId, identifier])
  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([templateId])
  @@map("task")
}

/// Last number handed out for a task identifier prefix (`AB` → `AB-<value>`).
/// Incremented atomically so concurrent creates never get the same number.
model TaskIdentifierCounter {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prefix         String
  value          Int

  @@id([organizationId, prefix])
  @@map("task_identifier_counter")
}

model TaskTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  status         String       @default("todo")
  priority       String       @default("medium")
  labelIds       String[]
  /// Custom form fields (`TaskTemplateField[]`) shown when this template is used.
  fields         Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tasks Task[]

  @@index([organizationId])
  @@index([projectId])
  @@map("taskTemplate")
}

model TaskLabel {
  taskId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  @@map("taskLabel")
}

model Subtask {
  id     String  @id @default(cuid())
  taskId String
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title  String
  done   Boolean @default(false)
  order  Int     @default(0)

  @@index([taskId])
  @@map("subtask")
}

model TaskComment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId   String
  /// internal | client — frozen at write time so the two sides render differently.
  authorKind String   @default("internal")
  authorName String?
  body       String
  createdAt  DateTime @default(now())

  @@index([taskId])
  @@map("taskComment")
}

model ProjectActivity {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId   String
  action    String
  target    String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@map("projectActivity")
}

/// A message of the shared project thread between the team and the client.
/// `authorKind` is internal | client and is frozen at write time so the two
/// sides render differently even if the author's membership changes.
model ProjectMessage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId       String
  authorKind     String       @default("internal")
  body           String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([projectId, createdAt])
  @@map("projectMessage")
}

/// A GitHub / GitLab repository connected to a project. Tasks and issues are
/// kept in sync both ways; a project owns at most one repository connection.
model RepositoryConnection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @unique
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Enum-like: `github` | `gitlab`.
  provider       String
  /// Web/instance URL for self-managed GitLab or GitHub Enterprise; null
  /// means github.com / gitlab.com.
  baseUrl        String?
  /// Repository owner (user, org or GitLab group path, subgroups included).
  owner          String
  repo           String
  repoUrl        String
  /// Secret used to verify incoming webhooks (GitHub HMAC / GitLab token).
  webhookSecret  String
  createdById    String
  lastSyncedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, provider, owner, repo])
  @@index([organizationId])
  @@map("repositoryConnection")
}

/// A personal access token a user saved for repository integrations. Tokens
/// are encrypted with `BETTER_AUTH_SECRET` and are the credential behind every
/// issue/pull request that user creates or edits, so remote items are
/// authored by and attributed to them. Users without a usable token cannot
/// push to a connected repository.
model UserRepositoryToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Enum-like: `github` | `gitlab`.
  provider    String
  accessToken String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@map("userRepositoryToken")
}

// ---------------------------------------------------------------------------
// Calendars & events
// ---------------------------------------------------------------------------

model Calendar {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("blue")
  kind           String       @default("personal")
  visible        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  members CalendarMember[]
  events  CalendarEvent[]

  @@index([organizationId])
  @@map("calendar")
}

model CalendarMember {
  id         String   @id @default(cuid())
  calendarId String
  calendar   Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([calendarId, userId])
  @@index([userId])
  @@map("calendarMember")
}

model CalendarEvent {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendarId      String
  calendar        Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  startAt         DateTime
  endAt           DateTime
  allDay          Boolean      @default(false)
  location        String?
  meetingUrl      String?
  /// Optional password/access code shared with online meeting attendees.
  meetingPassword String?
  color           String       @default("blue")
  reminderMinutes Int?
  createdBy       String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attendees      EventAttendee[]
  meetingRequest MeetingRequest?

  @@index([organizationId])
  @@index([calendarId])
  @@index([startAt])
  @@map("calendarEvent")
}

model EventAttendee {
  id       String        @id @default(cuid())
  eventId  String
  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId   String
  response String        @default("pending")

  @@unique([eventId, userId])
  @@index([userId])
  @@map("eventAttendee")
}

// ---------------------------------------------------------------------------
// Meetings requested by client-portal users
// ---------------------------------------------------------------------------

/// Organization-level rules for client meeting requests. A missing row means
/// the defaults below (requests enabled, overlaps refused).
model MeetingSettings {
  id     String @id @default(cuid())
  /// One settings row per organization.
  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Whether client-portal users may request meetings at all.
  clientRequestsEnabled Boolean @default(true)
  /// Refuse a request that overlaps another meeting instead of flagging it.
  autoDeclineOverlaps Boolean @default(true)
  /// How far ahead (days from today) a meeting may be requested.
  bookingWindowDays Int @default(30)
  /// Minimum notice before the requested slot (hours).
  minNoticeHours Int @default(24)
  /// Duration pre-selected in the portal form (minutes).
  defaultDurationMinutes Int @default(30)
  /// Longest meeting a client may request (minutes).
  maxDurationMinutes Int @default(120)
  /// Meeting app used when a request is accepted: manual | google_meet |
  /// microsoft_teams | zoom. Credentials for an app are added with its
  /// provider adapter in `lib/meetings/providers.ts`.
  provider String @default("manual")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("meetingSettings")
}

/// A meeting proposal from a client company. The client proposes several
/// candidate slots; accepting one creates a `CalendarEvent` on a team
/// calendar.
model MeetingRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  /// Candidate slots proposed by the client, in display order.
  slots           MeetingSlot[]
  /// online | in_person
  mode            String  @default("online")
  /// Online meetings: join link provided by the client.
  meetingUrl      String?
  /// Online meetings: optional access code/password.
  meetingPassword String?
  /// In-person meetings: address provided by the client.
  address         String?
  /// pending | accepted | declined | cancelled
  status          String  @default("pending")

  requestedById   String
  requestedByName String
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  /// Reason given on decline, or a message shown to the client on accept.
  decisionNote    String?

  /// Calendar event created when the request is accepted.
  calendarEventId String?        @unique
  calendarEvent   CalendarEvent? @relation(fields: [calendarEventId], references: [id], onDelete: SetNull)
  /// Meeting app adapter that produced the join link (manual until connected).
  provider          String  @default("manual")
  externalMeetingId String?
  externalJoinUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([clientId])
  @@map("meetingRequest")
}

/// One proposed time of a meeting request. Exactly one slot is marked
/// `selected` when the team accepts the request.
model MeetingSlot {
  id        String         @id @default(cuid())
  requestId String
  request   MeetingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  startAt   DateTime
  endAt     DateTime
  /// Display order of the proposal (0-based).
  position  Int            @default(0)
  /// Set on the slot the team picked when accepting.
  selected  Boolean        @default(false)

  @@unique([requestId, startAt])
  @@index([requestId])
  @@index([startAt])
  @@map("meetingSlot")
}

// ---------------------------------------------------------------------------
// Files
// ---------------------------------------------------------------------------

model FileNode {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  kind           String       @default("other")
  parentId       String?
  parent         FileNode?    @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       FileNode[]   @relation("FileTree")
  ownerId        String
  modifiedAt     DateTime     @default(now())
  sizeBytes      Int?
  starred        Boolean      @default(false)
  trashed        Boolean      @default(false)
  trashedAt      DateTime?
  shared         Boolean      @default(false)
  restricted     Boolean      @default(false)
  oid            BigInt?      @unique
  mimeType       String?
  sha256         String?
  createdAt      DateTime     @default(now())

  shares       FileShare[]
  versions     FileVersion[]
  activities   FileActivity[]
  crmDocuments CrmDocument[]

  @@index([organizationId, parentId])
  @@index([ownerId])
  @@map("fileNode")
}

/// A resumable chunked upload in progress. Each file is streamed into a
/// PostgreSQL large object across several requests; this row tracks the large
/// object and the bytes received.
/// `status` is `open`, `complete`, or `aborted`. Orphaned `open` rows (and their
/// large objects) are swept once `expiresAt` passes.
model UploadSession {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  name           String
  parentId       String?
  kind           String   @default("other")
  mimeType       String?
  oid            BigInt
  expectedSize   Int?
  receivedBytes  Int      @default(0)
  sha256         String?
  transient      Boolean  @default(false)
  status         String   @default("open")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("uploadSession")
}

model FileShare {
  id         String   @id @default(cuid())
  fileId     String
  file       FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId     String
  permission String   @default("view")
  createdAt  DateTime @default(now())

  @@unique([fileId, userId])
  @@index([userId])
  @@map("fileShare")
}

model FileVersion {
  id        String   @id @default(cuid())
  fileId    String
  file      FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId    String
  at        DateTime @default(now())
  note      String
  oid       BigInt?
  mimeType  String?
  sha256    String?
  sizeBytes Int?

  @@index([fileId])
  @@map("fileVersion")
}

model FileActivity {
  id     String   @id @default(cuid())
  fileId String
  file   FileNode @relation(fields: [fileId], references: [id], onDelete: Cascade)
  userId String
  action String
  at     DateTime @default(now())

  @@index([fileId])
  @@map("fileActivity")
}

// ---------------------------------------------------------------------------
// Messaging
// ---------------------------------------------------------------------------

model ChatTeam {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())

  conversations Conversation[]

  @@index([organizationId])
  @@map("chatTeam")
}

model Conversation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind           String       @default("channel")
  name           String
  teamId         String?
  team           ChatTeam?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  topic          String?
  unreadCount    Int          @default(0)
  lastMessageAt  DateTime     @default(now())
  muted          Boolean      @default(false)
  pinned         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  members  ConversationMember[]
  messages Message[]

  @@index([organizationId])
  @@index([teamId])
  @@map("conversation")
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversationMember")
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId        String
  body            String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  edited          Boolean      @default(false)
  system          Boolean      @default(false)
  parentId        String?
  parent          Message?     @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies         Message[]    @relation("Thread")
  meetingTitle    String?
  meetingStartsAt DateTime?
  meetingDuration Int?

  reactions   MessageReaction[]
  attachments MessageAttachment[]

  @@index([conversationId])
  @@index([parentId])
  @@map("message")
}

model MessageReaction {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  emoji     String
  userId    String

  @@unique([messageId, emoji, userId])
  @@index([messageId])
  @@map("messageReaction")
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  kind      String  @default("file")
  meta      String?
  oid       BigInt?
  mimeType  String?
  sha256    String?
  sizeBytes Int?

  @@index([messageId])
  @@map("messageAttachment")
}

// ---------------------------------------------------------------------------
// HR: time, attendance, leave & capacity
// ---------------------------------------------------------------------------

/// Per-user HR settings for the time & attendance module: employment type,
/// contract, weekly hours, optional manager/validator designation.
model HrProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  employmentType String       @default("employee") // associate | employee | intern | contractor
  contractType   String       @default("cdi") // cdi | cdd | internship | freelance | other
  weeklyHours    Float        @default(35)
  managerId      String?
  isValidator    Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@map("hrProfile")
}

/// Half-day attendance: up to two rows per user per day (morning/afternoon).
/// `status` is the primary half-day status; `location` refines where working
/// halves are spent. A half-day can be allocated to a project or an internal
/// activity (at most one of the two).
model AttendanceEntry {
  id                 String            @id @default(cuid())
  organizationId     String
  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String
  date               DateTime          @db.Date
  period             String // morning | afternoon
  status             String // on_site | remote | leave | rtt | sick_leave | training | business_trip | holiday | unavailable | other
  location           String? // on_site | remote | client_site | traveling | other
  projectId          String?
  project            Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  internalActivityId String?
  internalActivity   InternalActivity? @relation(fields: [internalActivityId], references: [id], onDelete: SetNull)
  leaveRequestId     String?
  leaveRequest       LeaveRequest?     @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  isBillable         Boolean           @default(false)
  comment            String?
  createdBy          String
  updatedBy          String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([organizationId, userId, date, period])
  @@index([organizationId, date])
  @@index([userId, date])
  @@index([projectId])
  @@map("attendanceEntry")
}

/// A leave request covering [startDate .. endDate] with half-day precision.
/// `halfDays` counts working half-days (Mon-Fri, excluding French public
/// holidays). Approved requests materialize `AttendanceEntry` rows and count
/// against the requester's leave balance.
model LeaveRequest {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  type            String // paid_leave | rtt | unpaid | sick | training | other
  status          String       @default("pending") // pending | approved | rejected | cancelled
  startDate       DateTime     @db.Date
  endDate         DateTime     @db.Date
  startPeriod     String       @default("morning") // morning | afternoon
  endPeriod       String       @default("afternoon") // morning | afternoon
  halfDays        Float
  comment         String?
  validatorId     String?
  decisionDate    DateTime?
  decisionComment String?
  attachmentUrl   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  attendanceEntries AttendanceEntry[]

  @@index([organizationId, status])
  @@index([organizationId, userId])
  @@map("leaveRequest")
}

/// Days allowance for one user, leave type and year. `allowanceDays` is the
/// acquired amount; manual adjustments are tracked in `LeaveAdjustment`.
model LeaveBalance {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  leaveType      String // paid_leave | rtt | recovery | unpaid | training | other
  year           Int
  allowanceDays  Float        @default(0)
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId, leaveType, year])
  @@map("leaveBalance")
}

/// A manual balance adjustment (positive or negative), with an audit trail.
model LeaveAdjustment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  leaveType      String
  year           Int
  days           Float
  note           String?
  createdBy      String
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, year])
  @@map("leaveAdjustment")
}

/// A client company. Serves both the CRM (companies) and project billing.
model Client {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactEmail   String?
  isActive       Boolean      @default(true)
  /// CRM lifecycle: prospect | active | inactive
  status         String       @default("prospect")
  industry       String?
  website        String?
  phone          String?
  address        String?
  description    String?
  source         String?
  ownerId        String?
  /// CRM custom field values keyed by CrmFieldDefinition.key.
  customFields   Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects        Project[]
  contacts        ContactCompany[]
  deals           Deal[]
  activities      CrmActivity[]
  portalMembers   Member[]         @relation("PortalMembers")
  portalInvites   PortalInvite[]
  meetingRequests MeetingRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
  @@map("client")
}

/// A person working at one or more client companies.
model Contact {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  notes          String?
  ownerId        String?
  customFields   Json?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  companies  ContactCompany[]
  deals      DealContact[]
  activities CrmActivity[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@map("contact")
}

/// Many-to-many association between contacts and companies.
model ContactCompany {
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@id([contactId, clientId])
  @@index([clientId])
  @@map("contactCompany")
}

/// A configurable sales pipeline.
model Pipeline {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stages PipelineStage[]
  deals  Deal[]

  @@unique([organizationId, name])
  @@map("pipeline")
}

/// A stage of a pipeline. `type` is open | won | lost and drives forecasting.
model PipelineStage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int      @default(0)
  type       String   @default("open")
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deals Deal[]

  @@unique([pipelineId, name])
  @@index([pipelineId, position])
  @@map("pipelineStage")
}

/// A sales opportunity linked to a company and one or more contacts.
model Deal {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  clientId          String?
  client            Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  pipelineId        String?
  pipeline          Pipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stageId           String?
  stage             PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  amount            Float          @default(0)
  currency          String         @default("EUR")
  probability       Int            @default(50)
  /// open | won | lost
  status            String         @default("open")
  expectedCloseDate DateTime?      @db.Date
  actualCloseDate   DateTime?      @db.Date
  lossReason        String?
  source            String?
  description       String?
  ownerId           String?
  position          Int            @default(0)
  customFields      Json?
  deletedAt         DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  contacts   DealContact[]
  activities CrmActivity[]

  @@index([organizationId, status])
  @@index([clientId])
  @@index([stageId])
  @@map("deal")
}

/// Many-to-many association between deals and contacts.
model DealContact {
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  isPrimary Boolean @default(false)

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("dealContact")
}

/// CRM timeline entry: note, call, email or meeting.
model CrmActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String       @default("note")
  subject        String?
  body           String
  occurredAt     DateTime     @default(now())
  authorId       String
  clientId       String?
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, occurredAt])
  @@index([clientId])
  @@index([contactId])
  @@index([dealId])
  @@map("crmActivity")
}

/// Custom field definition for CRM records (client | contact | deal).
model CrmFieldDefinition {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         String
  key            String
  label          String
  type           String
  options        Json?
  isRequired     Boolean      @default(false)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, entity, key])
  @@map("crmFieldDefinition")
}

/// A file attached to a CRM record (company, contact or deal). `visibility`
/// is internal | client; client-visible documents are exposed in the portal.
model CrmDocument {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fileId         String
  file           FileNode     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entity         String
  entityId       String
  visibility     String       @default("internal")
  addedBy        String
  createdAt      DateTime     @default(now())

  @@unique([fileId, entity, entityId])
  @@index([organizationId, entity, entityId])
  @@map("crmDocument")
}

/// In-app notification for one user. `data` carries the interpolation values
/// (names, identifiers, ids) for the type-specific message rendered by the UI.
model Notification {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  actorId        String?
  type           String
  data           Json?
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, userId, createdAt])
  @@index([userId, readAt])
  @@map("notification")
}

/// Pending portal access for a company contact: tracks the matching better-auth
/// invitation so that the member row can be linked to the company on acceptance.
model PortalInvite {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  email          String
  name           String?
  invitationId   String?      @unique
  invitedById    String?
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?

  @@index([organizationId, clientId])
  @@index([email])
  @@map("portalInvite")
}

/// An internal (non-client) activity time can be allocated to, e.g. product
/// development, sales, administration. `kind` is internal (investment) or
/// non_billable.
model InternalActivity {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  kind           String       @default("internal") // internal | non_billable
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attendanceEntries AttendanceEntry[]

  @@unique([organizationId, name])
  @@map("internalActivity")
}

/// Audit trail for sensitive HR actions: who did what, on which entity, with
/// before/after snapshots.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@map("auditLog")
}

/// Organization-wide HR defaults for the time & attendance module.
model HrSettings {
  id                    String       @id @default(cuid())
  organizationId        String       @unique
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultWeeklyHours    Float        @default(35)
  defaultAllowanceDays  Float        @default(25)
  lowBalanceThreshold   Float        @default(5)
  pendingValidationDays Int          @default(3)
  defaultEmployeeRate   Float        @default(22)
  defaultEmployerRate   Float        @default(42)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("hrSettings")
}

/// Payroll settings for one member: hourly wage, payroll category and French
/// contribution rates (employee = cotisations salariales, employer =
/// cotisations patronales). Rates are percentages of the gross pay.
model SalaryProfile {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  salaryType     String       @default("full_time") // full_time | part_time | intern | apprentice | contractor | other
  hourlyRate     Float        @default(0)
  employeeRate   Float        @default(22)
  employerRate   Float        @default(42)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@map("salaryProfile")
}

// OAuth / MCP (better-auth jwt + mcp plugins)
// ---------------------------------------------------------------------------

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String    @id
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]  @default([])
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  user                             User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]  @default([])
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]  @default([])
  postLogoutRedirectUris           String[]  @default([])
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]  @default([])
  responseTypes                    String[]  @default([])
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  refreshTokens   OauthRefreshToken[]
  accessTokens    OauthAccessToken[]
  consents        OauthConsent[]
  clientResources OauthClientResource[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String    @id
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]  @default([])
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clientResources OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@unique([clientId, resourceId])
  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String      @id
  token                   String      @unique
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]    @default([])

  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]           @default([])
  requestedUserInfoClaims String[]           @default([])
  refreshId               String?
  refresh                 OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime
  createdAt               DateTime
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]           @default([])

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]    @default([])
  requestedUserInfoClaims String[]    @default([])
  scopes                  String[]    @default([])
  createdAt               DateTime
  updatedAt               DateTime

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

// ---------------------------------------------------------------------------
// Control tower (platform administration)
// ---------------------------------------------------------------------------

/// Audit trail for actions taken from the control-tower app. Deliberately
/// separate from `AuditLog` (which is organization-scoped and readable by org
/// admins) and intentionally stores denormalized actor/target labels so the
/// record survives user or organization deletion.
model PlatformAuditEvent {
  id             String   @id @default(cuid())
  actorId        String
  actorEmail     String
  actorRole      String
  action         String
  targetType     String
  targetId       String
  organizationId String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([organizationId])
  @@map("platformAuditEvent")
}

/// Single-use, short-lived grant that lets a platform admin open a session in
/// the customer app (impersonation handoff). Only the SHA-256 of the token is
/// stored; the plaintext is returned once to the caller.
model PlatformHandoff {
  id             String    @id @default(cuid())
  tokenHash      String    @unique
  kind           String    @default("impersonate")
  actorId        String
  targetUserId   String
  organizationId String?
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
  @@index([targetUserId])
  @@map("platformHandoff")
}

/// TOTP secret and backup codes for platform staff. Required for every account
/// holding a platform role; the web app does not register the plugin, so this
/// table stays control-tower-only.
model TwoFactor {
  id                     String    @id @default(cuid())
  secret                 String
  backupCodes            String
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified               Boolean?  @default(true)
  failedVerificationCount Int      @default(0)
  lockedUntil            DateTime?

  @@index([userId])
  @@map("twoFactor")
}


// ---------------------------------------------------------------------------
// AI usage
// ---------------------------------------------------------------------------

/// One row per assistant run. Cost is computed at write time so historical
/// rows keep the price that applied when the tokens were spent.
model AiUsageEvent {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Kept without a relation so usage survives the user's deletion.
  userId         String
  model          String
  requests       Int
  inputTokens    Int
  outputTokens   Int
  cachedTokens   Int
  /// Micro-USD (1e-6 USD).
  costMicros     Int
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_event")
}

/// Shared rate-limit counters. Better Auth owns the `ip|path` rows for its
/// auth endpoints; `apps/web/lib/core/rate-limit.ts` owns the `app:` rows.
/// Kept in Postgres so every replica sees one counter (issue #90).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  /// Epoch milliseconds: last request (Better Auth) or window start (app rows).
  lastRequest BigInt

  @@index([lastRequest])
  @@map("rateLimit")
}
