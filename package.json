{
  "name": "asynchrone-space",
  "version": "0.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test:contracts": "turbo test:contracts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:helm": "node scripts/verify-helm-charts.mjs",
    "verify:connection-budget": "node scripts/verify-connection-budget.mjs",
    "split:prisma": "node scripts/split-prisma-schema.mjs",
    "verify:prisma-schemas": "node scripts/verify-prisma-schemas.mjs",
    "db:create": "node scripts/create-databases.mjs",
    "seed": "npm run seed --workspace=@workspace/seed --",
    "migrate:deploy": "npm run migrate:deploy --workspace=@workspace/migrate",
    "migrate:status": "npm run migrate:status --workspace=@workspace/migrate",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "split:databases": "node scripts/split-databases.mjs",
    "generate:all": "npm run generate --workspace=@workspace/db && npm run generate --workspace=@workspace/db-identity && npm run generate --workspace=@workspace/db-projects && npm run generate --workspace=@workspace/db-calendars && npm run generate --workspace=@workspace/db-files && npm run generate --workspace=@workspace/db-messages && npm run generate --workspace=@workspace/db-clients && npm run generate --workspace=@workspace/db-employees && npm run generate --workspace=@workspace/db-control-tower",
    "test:unit": "turbo run test:unit"
  },
  "devDependencies": {
    "@rolldown/binding-wasm32-wasi": "^1.2.15",
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "pg-copy-streams": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^7"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true,
    "@parcel/watcher": true,
    "@swc/core": true
  }
}
