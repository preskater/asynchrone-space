{
  "name": "asynchrone-space",
  "version": "0.0.1",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "*",
    "@workspace/typescript-config": "*",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.10",
    "typescript": "^7"
  },
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
